# Copy this file to .env and fill in your values.
# The app reads these from environment variables / Streamlit secrets.
# On Streamlit Community Cloud, set them under app Settings -> Secrets.

# Google Gemini free tier key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides (Gemini free tier defaults are used if unset):
# API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash